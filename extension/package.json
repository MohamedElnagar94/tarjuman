{
  "name": "tarjuman-extension",
  "version": "3.0.3",
  "private": true,
  "description": "Tarjuman browser extension: synced Arabic subtitles and live dubbing on any video, powered by your own local Tarjuman server.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "vue-tsc --noEmit && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "promo": "node scripts/render-promo.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.1.0",
    "@fontsource/tajawal": "^5.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "playwright-core": "^1.49.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
