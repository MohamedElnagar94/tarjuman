# ترجمان: إعدادات التشغيل
# Tarjuman: runtime settings
#
# انسخ هذا الملف باسم ‎.env‎ بجانبه ثم عدّل ما تريد. يُقرأ الملف عند بدء التشغيل،
# فأعد تشغيل ترجمان بعد أي تعديل. المتغير المضبوط في النظام نفسه يغلب قيمة هذا الملف.
# السطر الذي يبدأ بعلامة # معطّل، ويُستخدم بدله الافتراضي.
#
# Copy this file to .env next to it and edit what you need. It is read at startup,
# so restart Tarjuman after a change. A variable set in the real environment wins
# over this file. A line starting with # is off, and the default is used instead.


# ───────────── المكان والشبكة / Location and network ─────────────

# المجلد الذي يُحفظ فيه data/ (الفيديوهات، الترجمات، الأصوات، الإعدادات).
# الافتراضي: مجلد المشروع نفسه. اكتب مسارًا كاملًا إن أردت قرصًا آخر.
# Folder that holds data/ (videos, subtitles, voices, settings).
# Default: the project folder. Give a full path to keep it on another disk.
# TARJUMAN_HOME=D:\TarjumanData

# أول منفذ يُجرَّب. إن كان مشغولًا ينتقل ترجمان إلى الذي بعده، والإضافة تجده وحدها.
# القيم: رقم منفذ من 1024 إلى 65535. الافتراضي 4318.
# First port to try. If it is busy Tarjuman moves up, and the extension follows.
# Values: a port number, 1024 to 65535. Default 4318.
TARJUMAN_PORT=4318

# من يستطيع الوصول إلى ترجمان.
#   0.0.0.0    الحاسوب والهواتف المربوطة على شبكة الـ Wi-Fi (الافتراضي)
#   127.0.0.1  هذا الحاسوب فقط، وتتعطل ميزة الهاتف
# Who can reach Tarjuman.
#   0.0.0.0    this computer and paired phones on the Wi-Fi (default)
#   127.0.0.1  this computer only; the phone feature is off
TARJUMAN_HOST=0.0.0.0


# ───────────── الهاتف والأمان / Phone and security ─────────────

# مدة صلاحية رمز ربط الهاتف (رمز QR) بالدقائق، ثم يظهر رمز جديد في الإعدادات.
# الهواتف المربوطة لا تتأثر. القيم: أي عدد موجب، أو 0 ليبقى الرمز حتى تطلب غيره. الافتراضي 15.
# Minutes a phone pairing code (the QR) works before Settings shows a new one.
# Paired phones are not affected. Values: any positive number, or 0 to keep the
# code until you ask for a new one. Default 15.
TARJUMAN_PAIR_MINUTES=15

# السماح بتنزيل فيديو من عنوان داخل شبكتك المحلية (خادم وسائط منزلي مثلًا).
#   0  ممنوع (الافتراضي، وهو الأأمن)
#   1  مسموح
# Allow downloading a video from an address inside your own network (a media
# server at home, for example).
#   0  refused (default, and the safer choice)
#   1  allowed
TARJUMAN_FETCH_PRIVATE=0


# ───────────── الحدود والموارد / Limits and resources ─────────────

# أكبر حجم لفيديو ترفعه من حاسوبك، بالغيغابايت. الافتراضي 8.
# Largest video you can upload from your computer, in gigabytes. Default 8.
TARJUMAN_MAX_UPLOAD_GB=8

# الحد الأعلى لحجم أصوات الدبلجة المحفوظة، بالغيغابايت. عند تجاوزه يُحذف الأقدم استخدامًا.
# الافتراضي 2.
# Size limit of the saved dub voices, in gigabytes. Beyond it the least recently
# used clips are removed. Default 2.
TARJUMAN_VOICE_CACHE_GB=2

# عدد المهام الثقيلة التي تعمل معًا (تفريغ Whisper، الدبلجة إلى MP4، حرق الترجمة).
# الباقي ينتظر دوره. التنزيل لا يُحسب منها.
#   1  للحواسيب الضعيفة أو ذات الذاكرة القليلة (8 غيغابايت أو أقل)
#   2  الافتراضي
#   3  للحواسيب القوية
# How many heavy jobs run together (Whisper transcription, dubbing to MP4,
# burning subtitles). The rest wait their turn. Downloads don't count.
#   1  for a weak computer or little memory (8 GB or less)
#   2  default
#   3  for a strong computer
TARJUMAN_HEAVY_JOBS=2

# أقصى عدد للمهام المنتظرة. بعده تُرفض المهمة الجديدة برسالة واضحة. الافتراضي 20.
# Most jobs that may wait in the queue. Beyond it a new job is refused with a
# clear message. Default 20.
TARJUMAN_MAX_QUEUE=20


# ───────────── التفريغ الصوتي / Speech recognition ─────────────

# نموذج Whisper المستخدم حين لا يكون للفيديو ترجمة. الأكبر أدق وأبطأ ويأخذ ذاكرة أكثر.
# اتركه فارغًا (المستحسن): يُختار من الإعدادات ← التفريغ الصوتي، حيث يقترح التطبيق نموذجًا
# يناسب جهازك ويشرح السبب. إن وضعت قيمة هنا استُعملت ما دام ذلك الإعداد على «تلقائي».
#   tiny | base | small | medium | large-v3-turbo | large-v3
# يُنزَّل النموذج تلقائيًا عند أول استخدام.
# Whisper model used when a video has no captions. Bigger is more accurate,
# slower, and needs more memory.
# Empty (recommended): chosen in Settings -> Transcription, where the app recommends
# one for this computer and explains why. A value here is used while that setting is "auto".
#   tiny | base | small | medium | large-v3-turbo | large-v3
# The model is downloaded by itself the first time it is used.
TARJUMAN_WHISPER_MODEL=

# تجاهل ترجمات يوتيوب الجاهزة وتفريغ الصوت بـ Whisper دائمًا. للتجربة والاختبار.
#   0  استخدم ترجمات يوتيوب إن وُجدت (الافتراضي)
#   1  فرّغ بـ Whisper دائمًا
# Ignore YouTube's own captions and always transcribe with Whisper. For testing.
#   0  use YouTube's captions when there are any (default)
#   1  always transcribe with Whisper
TARJUMAN_FORCE_ASR=0


# ───────────── الذكاء الاصطناعي / AI ─────────────

# مفتاح Claude، يُستخدم فقط إن لم تحفظ مفتاحًا من صفحة الإعدادات. اتركه معطّلًا إن لم تحتج إليه.
# هذا سر: لا تضعه في ‎.env.example‎ ولا ترفعه إلى GitHub. ملف ‎.env‎ مستثنى من git.
# Claude key, used only when no key is saved in the Settings page. Leave it off
# if you don't need it. This is a secret: never put it in .env.example or push
# it to GitHub. The .env file is ignored by git.
# ANTHROPIC_API_KEY=
